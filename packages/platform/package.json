{
  "name": "@vertex/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hosts modules: the registry, the edition they are composed into, the event bus and the unit of work. Knows what a module is, never what any module does.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vertex/kernel": "workspace:*"
  },
  "devDependencies": {
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  }
}

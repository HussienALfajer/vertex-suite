{
  "name": "@vertex/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The interface layer of design-system.md: generated palette, semantic tokens, and the components every screen is built from.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./palette.css": "./src/tokens/palette.generated.css",
    "./theme.css": "./src/tokens/theme.generated.css",
    "./fonts.css": "./src/tokens/fonts.generated.css",
    "./tailwind.css": "./src/tokens/tailwind.generated.css"
  },
  "files": [
    "dist",
    "src/tokens/*.generated.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens": "tsc -p tsconfig.build.json && node dist/tokens/build.js"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "20.14.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@vertex/i18n": "workspace:*",
    "@vertex/kernel": "workspace:*",
    "clsx": "2.1.1",
    "react-aria-components": "1.21.1"
  }
}

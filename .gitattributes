# Line endings are LF in the repository and LF in every working tree, on every
# platform. Without this, Git's autocrlf checks the same file out as CRLF on
# Windows and LF on Linux, and `prettier --check` — which requires LF — passes
# on one CI runner and fails on the other.
* text=auto eol=lf

# Generated; do not offer it in a diff or count it in language statistics.
pnpm-lock.yaml -diff linguist-generated

# Binary assets: never normalised, never diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.exe binary
*.dll binary
*.node binary

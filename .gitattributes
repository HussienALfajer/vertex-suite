# Line endings are LF in the repository and LF in every working tree, on every
# platform. Without this, Git's autocrlf checks the same file out as CRLF on
# Windows and LF on Linux, and `prettier --check` — which requires LF — passes
# on one CI runner and fails on the other.
* text=auto eol=lf

# Collapsed by default in review and excluded from language statistics, but
# still diffable as text: a change to a pinned dependency is exactly the kind of
# thing that must remain reviewable.
pnpm-lock.yaml linguist-generated=true

# Binary assets: never normalised, never diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.exe binary
*.dll binary
*.node binary

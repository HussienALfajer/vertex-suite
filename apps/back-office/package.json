{
  "name": "@vertex/back-office",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Administration, purchasing and reporting — the screens a tenant runs its own shop from.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",

# Every dependency is pinned exactly. A build of a given tag must produce the same
# bytes, or signing the update package in SYS-10 means nothing.
save-exact=true

# Refuse to install under a Node version the workspace does not declare.
engine-strict=true

# Packages may only import what they declare. Catches accidental reliance on a
# transitive dependency, which would break the moment it is hoisted differently.
strict-peer-dependencies=false
auto-install-peers=true
